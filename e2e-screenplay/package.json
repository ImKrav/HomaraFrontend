    "@serenity-js/playwright-test": "3.48.0",
    "@serenity-js/rest": "3.48.0",
    "@serenity-js/web": "3.48.0",
    "@types/node": "^20",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5"
  }
}
