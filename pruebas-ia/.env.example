# Pruebas con IA de Homara (Browser Use y QA Wolf).
# Copia este archivo como .env y pon tus claves. El .env no se sube a Git.

# Claude (proveedor principal)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Gemini (alternativo, solo Browser Use con LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# anthropic | gemini
LLM_PROVIDER=anthropic

# App desplegada (VPS). En local: http://localhost:3000 y http://localhost:5000/api/v1
BASE_URL=https://homara.nodalix.tech
API_URL=https://homara-api.nodalix.tech/api/v1
