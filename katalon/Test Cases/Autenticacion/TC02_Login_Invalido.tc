<TestCaseEntity>
   <description>ESC02 - Inicio de sesión (negativo, data-driven). Objetivo: verificar que con credenciales inválidas no se inicia sesión, se muestra el mensaje de error esperado y se permanece en /login.</description>
   <name>TC02_Login_Invalido</name>
   <tag>ESC02,negativo,login,data-driven</tag>
