{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:regression": "vitest run tests/regression",
    "test:regression:demo": "node scripts/regression-demo.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "cypress run --spec \"cypress/e2e/regresion/**/*.cy.ts\"",
    "test:e2e:chrome": "cypress run --browser chrome --spec \"cypress/e2e/regresion/**/*.cy.ts\"",
    "test:e2e:edge": "cypress run --browser edge --spec \"cypress/e2e/regresion/**/*.cy.ts\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:component": "cypress run --component",
    "test:a11y": "cypress run --spec \"cypress/e2e/accesibilidad/**/*.cy.ts\"",
    "test:interfaz": "cypress run --spec \"cypress/e2e/interfaz/**/*.cy.ts\"",
    "test:interfaz:chrome": "cypress run --browser chrome --spec \"cypress/e2e/interfaz/**/*.cy.ts\"",
    "test:interfaz:edge": "cypress run --browser edge --spec \"cypress/e2e/interfaz/**/*.cy.ts\"",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:cypress": "cypress run && cypress run --component"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "postcss": "^8.5.15",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "~4.11.3",
    "cypress": "^14.5.4",
    "cypress-axe": "^1.7.0",
    "cypress-multi-reporters": "^2.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.1.1",
    "lighthouse": "^12.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
