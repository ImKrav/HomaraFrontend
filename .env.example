# ============================================
# Homara Frontend — Environment Variables
# ============================================
# All values below MIRROR the defaults inlined in `docker-compose.yml`.
#
# ┌─────────────────────────────────────────────────────────────┐
# │ You do NOT need to create a `.env` file to run the app.    │
# │ `docker compose up -d --build` works out of the box.       │
# └─────────────────────────────────────────────────────────────┘
#
# When is a `.env` (or `.env.local`) file actually required?
#   • When you run Next.js OUTSIDE Docker with `npm run dev`.
#   • When you want to override any of the inlined defaults below.

# Backend API URL (used by the browser and server-side fetch).
# Default points to HomaraBackend running on its own docker-compose
# stack on localhost:5000.
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# ---------------------------------------------------------------
# Optional: override any of the inlined defaults of docker-compose.yml.
# Uncomment and edit only the lines you want to change; the rest
# fall back to the inlined defaults of docker-compose.yml.
# ---------------------------------------------------------------

# Host port mapped to the frontend container (default: 3000).
# FRONTEND_PORT=3000
